# .gitignore

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg
MANIFEST
*.spec

# IDEs
.vscode/
.idea/
*.swp

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Heavy Media Files
*.mp4
*.gif
*.mov
*.avi
gif/

# Logs 
*.log
